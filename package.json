{
  "name": "guardbee-mcp",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "bench": "turbo run build --filter=@guardbee/guard-core && pnpm --filter @guardbee/pii-bench bench",
    "changeset": "changeset",
    "version-packages": "node scripts/version.mjs",
    "release": "turbo run build && changeset publish",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "secretlint"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.6",
    "@types/node": "26.6.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "secretlint": "^13.0.6",
    "tsx": "4.23.15",
    "turbo": "2.11.9",
    "typescript": "5.9.3",
    "vite": "^7.3.7",
    "vitest": "5.0.5"
  }
}
