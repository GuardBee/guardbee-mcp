{
  "name": "@guardbee/mcp-ssl-inspector",
  "version": "0.1.0",
  "description": "MCP server that inspects TLS certificates, cipher suites, and protocol configurations for any domain",
  "type": "module",
  "bin": {
    "guardbee-ssl-inspector": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "keywords": ["mcp", "security", "ssl", "tls", "certificate", "guardbee", "devtools"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GuardBee/guardbee-mcp-ssl-inspector"
  }
}
