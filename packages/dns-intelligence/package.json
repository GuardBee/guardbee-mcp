{
  "name": "@guardbee/mcp-dns-intelligence",
  "version": "0.10.0",
  "mcpName": "io.github.GuardBee/dns-intelligence",
  "description": "MCP server that enumerates DNS records, detects misconfigurations, and identifies dangling subdomains",
  "type": "module",
  "bin": {
    "guardbee-dns-intelligence": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "!dist/**/*.map",
    "!dist/**/__tests__"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@guardbee/mcp-telemetry": "workspace:^",
    "@modelcontextprotocol/server": "catalog:",
    "zod": "catalog:"
  },
  "keywords": [
    "mcp",
    "security",
    "dns",
    "recon",
    "subdomain",
    "spf",
    "dmarc",
    "guardbee",
    "devtools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GuardBee/guardbee-mcp.git",
    "directory": "packages/dns-intelligence"
  },
  "homepage": "https://guardbee.ai/en/what-is-mcp-dns-intelligence/",
  "bugs": {
    "url": "https://github.com/GuardBee/guardbee-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
