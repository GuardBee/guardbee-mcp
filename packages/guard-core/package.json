{
  "name": "@guardbee/guard-core",
  "version": "1.2.0",
  "description": "PII masking and prompt injection detection library: checksum-validated Turkish and international identifiers, KVKK special categories, secrets, and lethal-trifecta tool classification",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "!dist/**/*.map",
    "!dist/**/__tests__"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && node -e \"require('fs').mkdirSync('dist/cjs',{recursive:true});require('fs').writeFileSync('dist/cjs/package.json','{\\\"type\\\":\\\"commonjs\\\"}\\n')\"",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "guardbee",
    "pii",
    "kvkk",
    "prompt-injection",
    "lethal-trifecta",
    "security",
    "pii-detection",
    "pii-masking",
    "data-masking",
    "gdpr",
    "secrets-detection",
    "guardrails",
    "llm-security"
  ],
  "author": "GuardBee <hello@guardbee.ai>",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GuardBee/guardbee-mcp.git",
    "directory": "packages/guard-core"
  },
  "homepage": "https://github.com/GuardBee/guardbee-mcp/tree/main/packages/guard-core#readme",
  "bugs": {
    "url": "https://github.com/GuardBee/guardbee-mcp/issues"
  },
  "dependencies": {
    "semver": "^7.8.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/semver": "^7.8.0"
  }
}
