{
  "name": "@guardbee/mcp-security-proxy",
  "version": "1.25.2",
  "mcpName": "io.github.GuardBee/security-proxy",
  "description": "MCP gateway and LLM firewall: masks PII and secrets, blocks prompt injection and toxic flows (lethal trifecta), approves risky calls and keeps a hash-chained audit log, for MCP servers and LLM APIs",
  "author": "GuardBee <hello@guardbee.ai>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GuardBee/guardbee-mcp.git",
    "directory": "packages/security-proxy"
  },
  "homepage": "https://guardbee.ai/en/what-is-mcp-security-proxy/",
  "bugs": {
    "url": "https://github.com/GuardBee/guardbee-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "security",
    "proxy",
    "prompt-injection",
    "pii",
    "audit",
    "guardbee",
    "llm",
    "claude",
    "mcp-gateway",
    "llm-gateway",
    "ai-gateway",
    "guardrails",
    "firewall",
    "llm-firewall",
    "dlp",
    "pii-masking",
    "data-masking",
    "openai",
    "anthropic"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "guardbee-proxy": "dist/cli.js",
    "guardbee-hook": "dist/hook-cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "!dist/**/*.map",
    "!dist/**/__tests__"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "@guardbee/guard-core": "workspace:^",
    "@guardbee/mcp-document-scanner": "workspace:^",
    "@guardbee/mcp-telemetry": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@opentelemetry/api": "^1.9.1",
    "jose": "^6.2.12",
    "ldapts": "^9.2.0",
    "yaml": "^2.9.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "openai": "^7.39.0"
  },
  "peerDependencies": {
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/exporter-trace-otlp-http": {
      "optional": true
    },
    "@opentelemetry/resources": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-base": {
      "optional": true
    }
  }
}
