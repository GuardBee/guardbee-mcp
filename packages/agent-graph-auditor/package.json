{
  "name": "@guardbee/mcp-agent-graph-auditor",
  "version": "0.2.2",
  "mcpName": "io.github.GuardBee/agent-graph-auditor",
  "description": "MCP server that builds a reachability graph across multi-agent orchestration configs (LangGraph, CrewAI, AutoGen/ag2) to find transitive excessive agency — an agent with no dangerous tool of its own that can still reach one through delegation or group membership",
  "type": "module",
  "bin": {
    "guardbee-agent-graph-auditor": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "!dist/**/*.map",
    "!dist/**/__tests__"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@guardbee/mcp-telemetry": "workspace:^",
    "@modelcontextprotocol/sdk": "catalog:",
    "zod": "catalog:"
  },
  "keywords": [
    "mcp",
    "security",
    "ai-security",
    "multi-agent",
    "langgraph",
    "crewai",
    "autogen",
    "excessive-agency",
    "guardbee",
    "devtools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GuardBee/guardbee-mcp.git",
    "directory": "packages/agent-graph-auditor"
  },
  "homepage": "https://guardbee.ai/en/what-is-mcp-agent-graph-auditor/",
  "bugs": {
    "url": "https://github.com/GuardBee/guardbee-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
