{
  "name": "@guardbee/mcp-ssl-inspector",
  "version": "0.1.6",
  "description": "MCP server that inspects TLS certificates, cipher suites, and protocol configurations for any domain",
  "type": "module",
  "bin": {
    "guardbee-ssl-inspector": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@guardbee/mcp-telemetry": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^4.5.4"
  },
  "keywords": [
    "mcp",
    "security",
    "ssl",
    "tls",
    "certificate",
    "guardbee",
    "devtools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GuardBee/guardbee-mcp-ssl-inspector"
  }
}
