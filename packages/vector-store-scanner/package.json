{
  "name": "@guardbee/mcp-vector-store-scanner",
  "version": "0.3.0",
  "mcpName": "io.github.GuardBee/vector-store-scanner",
  "description": "MCP server that probes vector-database endpoints (Weaviate, Qdrant, Chroma, Elasticsearch/OpenSearch, Redis, Postgres/pgvector) for unauthenticated exposure of embeddings and RAG data",
  "type": "module",
  "bin": {
    "guardbee-vector-store-scanner": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "!dist/**/*.map",
    "!dist/**/__tests__"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@guardbee/mcp-telemetry": "workspace:^",
    "@modelcontextprotocol/server": "catalog:",
    "zod": "catalog:"
  },
  "keywords": [
    "mcp",
    "security",
    "ai-security",
    "vector-database",
    "rag",
    "exposure-scanner",
    "guardbee",
    "devtools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GuardBee/guardbee-mcp.git",
    "directory": "packages/vector-store-scanner"
  },
  "homepage": "https://guardbee.ai/en/what-is-mcp-vector-store-scanner/",
  "bugs": {
    "url": "https://github.com/GuardBee/guardbee-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
