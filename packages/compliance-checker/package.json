{
  "name": "@guardbee/mcp-compliance-checker",
  "version": "0.3.1",
  "mcpName": "io.github.GuardBee/compliance-checker",
  "description": "MCP server that checks KVKK, GDPR, and CCPA compliance for websites via the GuardBee API",
  "type": "module",
  "bin": {
    "guardbee-compliance-checker": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "!dist/**/*.map",
    "!dist/**/__tests__"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@guardbee/mcp-telemetry": "workspace:^",
    "@modelcontextprotocol/sdk": "catalog:",
    "zod": "catalog:"
  },
  "keywords": [
    "mcp",
    "compliance",
    "kvkk",
    "gdpr",
    "ccpa",
    "privacy",
    "guardbee",
    "devtools",
    "security"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GuardBee/guardbee-mcp.git",
    "directory": "packages/compliance-checker"
  },
  "homepage": "https://guardbee.ai/en/what-is-mcp-compliance-checker/",
  "bugs": {
    "url": "https://github.com/GuardBee/guardbee-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
