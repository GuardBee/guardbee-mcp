{
  "name": "@guardbee/mcp-config-auditor",
  "version": "0.2.0",
  "description": "MCP server that audits installed MCP client configs (Cursor, Claude Desktop, Windsurf, VS Code) for unpinned packages, secrets in env/args, wildcard auto-approve, unauthenticated remote endpoints, typosquats, and cross-server tool shadowing",
  "type": "module",
  "bin": {
    "guardbee-mcp-config-auditor": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "TR.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@guardbee/mcp-telemetry": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^4.5.4"
  },
  "keywords": [
    "mcp",
    "security",
    "mcp-security",
    "ai-security",
    "supply-chain",
    "guardbee",
    "devtools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GuardBee/guardbee-mcp.git",
    "directory": "packages/mcp-config-auditor"
  }
}
