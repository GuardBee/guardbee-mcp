{
  "name": "@guardbee/mcp-config-auditor",
  "version": "0.6.1",
  "mcpName": "io.github.GuardBee/mcp-config-auditor",
  "description": "MCP config auditor for Cursor, Claude Desktop, Windsurf and VS Code: unpinned packages, secrets, auto-approve wildcards, typosquats, shadow MCP servers and agent skills",
  "type": "module",
  "bin": {
    "guardbee-mcp-config-auditor": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "!dist/**/*.map",
    "!dist/**/__tests__"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@guardbee/mcp-telemetry": "workspace:^",
    "@modelcontextprotocol/sdk": "catalog:",
    "zod": "catalog:"
  },
  "keywords": [
    "mcp",
    "security",
    "mcp-security",
    "ai-security",
    "supply-chain",
    "guardbee",
    "devtools",
    "mcp-config",
    "shadow-ai",
    "cursor",
    "claude-desktop",
    "mcp-scanner"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GuardBee/guardbee-mcp.git",
    "directory": "packages/mcp-config-auditor"
  },
  "homepage": "https://guardbee.ai/en/what-is-mcp-config-auditor/",
  "bugs": {
    "url": "https://github.com/GuardBee/guardbee-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
