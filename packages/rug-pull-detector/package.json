{
  "name": "@guardbee/mcp-rug-pull-detector",
  "version": "0.4.1",
  "mcpName": "io.github.GuardBee/rug-pull-detector",
  "description": "MCP server that connects to another MCP server (stdio or Streamable HTTP), baselines its tools/list response, and detects 'rug pulls' \u2014 a tool silently changing description, schema, or annotations after it was already approved",
  "type": "module",
  "bin": {
    "guardbee-rug-pull-detector": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "!dist/**/*.map",
    "!dist/**/__tests__"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@guardbee/guard-core": "workspace:^",
    "@guardbee/mcp-telemetry": "workspace:^",
    "@guardbee/mcp-tool-poisoning-scanner": "workspace:^",
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "zod": "catalog:"
  },
  "keywords": [
    "mcp",
    "security",
    "ai-security",
    "mcp-security",
    "rug-pull",
    "tool-drift",
    "guardbee",
    "devtools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GuardBee/guardbee-mcp.git",
    "directory": "packages/rug-pull-detector"
  },
  "homepage": "https://guardbee.ai/en/what-is-mcp-rug-pull-detector/",
  "bugs": {
    "url": "https://github.com/GuardBee/guardbee-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "@modelcontextprotocol/server": "catalog:"
  }
}
