{
  "name": "@guardbee/mcp-ai-code-scanner",
  "version": "0.5.0",
  "mcpName": "io.github.GuardBee/ai-code-scanner",
  "description": "MCP server that scans code for insecure LLM/AI integration patterns \u2014 client-exposed API keys, unsafe handling of model output, excessive agent tool permissions, and PII sent to third-party LLMs",
  "type": "module",
  "bin": {
    "guardbee-ai-code-scanner": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "!dist/**/*.map",
    "!dist/**/__tests__"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@guardbee/mcp-telemetry": "workspace:^",
    "@modelcontextprotocol/server": "catalog:",
    "zod": "catalog:"
  },
  "keywords": [
    "mcp",
    "security",
    "ai-security",
    "llm-security",
    "owasp-llm-top-10",
    "guardbee",
    "devtools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GuardBee/guardbee-mcp.git",
    "directory": "packages/ai-code-scanner"
  },
  "homepage": "https://guardbee.ai/en/what-is-mcp-ai-code-scanner/",
  "bugs": {
    "url": "https://github.com/GuardBee/guardbee-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
