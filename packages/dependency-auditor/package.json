{
  "name": "@guardbee/mcp-dependency-auditor",
  "version": "0.7.1",
  "mcpName": "io.github.GuardBee/dependency-auditor",
  "description": "Dependency vulnerability scanner (OSV) for npm and pip manifests, with single-package lookups for PyPI, crates.io, Maven, Go and RubyGems; CLI and MCP server",
  "type": "module",
  "bin": {
    "guardbee-dependency-auditor": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "!dist/**/*.map",
    "!dist/**/__tests__"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@guardbee/mcp-telemetry": "workspace:^",
    "@modelcontextprotocol/sdk": "catalog:",
    "zod": "catalog:",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "keywords": [
    "mcp",
    "security",
    "dependency-audit",
    "cve",
    "osv",
    "guardbee",
    "devtools",
    "vulnerability-scanner",
    "sca",
    "npm-audit",
    "supply-chain"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GuardBee/guardbee-mcp.git",
    "directory": "packages/dependency-auditor"
  },
  "homepage": "https://guardbee.ai/en/what-is-mcp-dependency-auditor/",
  "bugs": {
    "url": "https://github.com/GuardBee/guardbee-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
