{
  "name": "@guardbee/security-suite",
  "version": "0.5.1",
  "mcpName": "io.github.GuardBee/security-suite",
  "description": "MCP security suite: every GuardBee scanner from one install, one MCP server with the tools you pick (OWASP MCP Top 10, secrets, prompt injection, toxic flows, supply chain, TLS/DNS) and a CLI that runs any of them",
  "type": "module",
  "bin": {
    "guardbee": "./dist/cli.js",
    "guardbee-suite": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "!dist/**/*.map",
    "!dist/**/__tests__"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@guardbee/mcp-a2a-auditor": "workspace:^",
    "@guardbee/mcp-agent-graph-auditor": "workspace:^",
    "@guardbee/mcp-ai-code-scanner": "workspace:^",
    "@guardbee/mcp-audit-gap-auditor": "workspace:^",
    "@guardbee/mcp-compliance-checker": "workspace:^",
    "@guardbee/mcp-config-auditor": "workspace:^",
    "@guardbee/mcp-context-oversharing-auditor": "workspace:^",
    "@guardbee/mcp-dependency-auditor": "workspace:^",
    "@guardbee/mcp-dns-intelligence": "workspace:^",
    "@guardbee/mcp-document-scanner": "workspace:^",
    "@guardbee/mcp-elicitation-auditor": "workspace:^",
    "@guardbee/mcp-llm-redteam": "workspace:^",
    "@guardbee/mcp-memory-poisoning-scanner": "workspace:^",
    "@guardbee/mcp-model-scanner": "workspace:^",
    "@guardbee/mcp-oauth-auditor": "workspace:^",
    "@guardbee/mcp-owasp-scan": "workspace:^",
    "@guardbee/mcp-prompt-injection-scanner": "workspace:^",
    "@guardbee/mcp-prompt-leak-scanner": "workspace:^",
    "@guardbee/mcp-reverse-shield": "workspace:^",
    "@guardbee/mcp-rug-pull-detector": "workspace:^",
    "@guardbee/mcp-secret-scanner": "workspace:^",
    "@guardbee/mcp-server-auditor": "workspace:^",
    "@guardbee/mcp-slopsquat-scanner": "workspace:^",
    "@guardbee/mcp-ssl-inspector": "workspace:^",
    "@guardbee/mcp-telemetry": "workspace:^",
    "@guardbee/mcp-threat-rules": "workspace:^",
    "@guardbee/mcp-tool-poisoning-scanner": "workspace:^",
    "@guardbee/mcp-toxic-flow-auditor": "workspace:^",
    "@guardbee/mcp-unbounded-consumption-auditor": "workspace:^",
    "@guardbee/mcp-vector-store-scanner": "workspace:^",
    "@guardbee/mcp-vulnerability-scanner": "workspace:^",
    "@modelcontextprotocol/sdk": "catalog:",
    "zod": "catalog:"
  },
  "keywords": [
    "mcp",
    "security",
    "secret-scanner",
    "dependency-audit",
    "ssl",
    "dns",
    "guardbee",
    "devtools",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GuardBee/guardbee-mcp.git",
    "directory": "packages/security-suite"
  },
  "homepage": "https://guardbee.ai/en/what-is-mcp-security-suite/",
  "bugs": {
    "url": "https://github.com/GuardBee/guardbee-mcp/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
