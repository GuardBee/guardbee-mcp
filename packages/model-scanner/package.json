{
  "name": "@guardbee/mcp-model-scanner",
  "version": "0.4.0",
  "mcpName": "io.github.GuardBee/model-scanner",
  "description": "MCP server that scans ML model files (PyTorch, pickle, joblib, dill, NumPy, safetensors, Keras, ONNX, GGUF, TensorFlow) and Hugging Face repos for supply-chain risks \u2014 malicious pickle gadgets, disguised or malformed headers, Keras Lambda-layer RCE, GGUF chat-template injection, and graph ops that touch files",
  "type": "module",
  "bin": {
    "guardbee-model-scanner": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "!dist/**/*.map",
    "!dist/**/__tests__"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@guardbee/mcp-telemetry": "workspace:^",
    "@modelcontextprotocol/server": "catalog:",
    "zod": "catalog:"
  },
  "keywords": [
    "mcp",
    "security",
    "ai-security",
    "llm-security",
    "model-security",
    "supply-chain",
    "pickle",
    "safetensors",
    "joblib",
    "gguf",
    "tensorflow",
    "huggingface",
    "guardbee",
    "devtools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GuardBee/guardbee-mcp.git",
    "directory": "packages/model-scanner"
  },
  "homepage": "https://guardbee.ai/en/what-is-mcp-model-scanner/",
  "bugs": {
    "url": "https://github.com/GuardBee/guardbee-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
