{
  "name": "@guardbee/mcp-owasp-scan",
  "version": "0.5.1",
  "mcpName": "io.github.GuardBee/owasp-scan",
  "description": "OWASP MCP Top 10 scanner: one CLI and MCP server that runs GuardBee's auditors over a codebase or a live MCP server, maps findings to MCP01\u2013MCP10 and grades A\u2013F",
  "type": "module",
  "bin": {
    "guardbee-owasp-scan": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "!dist/**/*.map",
    "!dist/**/__tests__"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@guardbee/guard-core": "workspace:^",
    "@guardbee/mcp-audit-gap-auditor": "workspace:^",
    "@guardbee/mcp-config-auditor": "workspace:^",
    "@guardbee/mcp-context-oversharing-auditor": "workspace:^",
    "@guardbee/mcp-oauth-auditor": "workspace:^",
    "@guardbee/mcp-secret-scanner": "workspace:^",
    "@guardbee/mcp-server-auditor": "workspace:^",
    "@guardbee/mcp-telemetry": "workspace:^",
    "@guardbee/mcp-tool-poisoning-scanner": "workspace:^",
    "@guardbee/mcp-toxic-flow-auditor": "workspace:^",
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "zod": "catalog:"
  },
  "keywords": [
    "mcp",
    "security",
    "ai-security",
    "mcp-security",
    "owasp",
    "owasp-mcp-top-10",
    "guardbee",
    "devtools",
    "security-scanner",
    "mcp-scanner",
    "sarif",
    "ci"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GuardBee/guardbee-mcp.git",
    "directory": "packages/owasp-scan"
  },
  "homepage": "https://guardbee.ai/en/what-is-mcp-owasp-scan/",
  "bugs": {
    "url": "https://github.com/GuardBee/guardbee-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
