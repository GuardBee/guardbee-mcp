{
  "name": "@guardbee/mcp-context-oversharing-auditor",
  "version": "0.2.1",
  "mcpName": "io.github.GuardBee/context-oversharing-auditor",
  "description": "MCP server that audits agent/MCP source for OWASP MCP10:2025 context oversharing — unrestricted session/memory dumps, cross-user shared context, system-prompt leakage via tools, and unscoped vector recalls",
  "type": "module",
  "bin": {
    "guardbee-context-oversharing-auditor": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "TR.md",
    "ZH.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@guardbee/mcp-telemetry": "workspace:^",
    "@modelcontextprotocol/sdk": "catalog:",
    "zod": "catalog:"
  },
  "keywords": [
    "mcp",
    "security",
    "ai-security",
    "mcp-security",
    "context-oversharing",
    "owasp",
    "mcp10",
    "kvkk",
    "guardbee",
    "devtools"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GuardBee/guardbee-mcp.git",
    "directory": "packages/context-oversharing-auditor"
  }
}
