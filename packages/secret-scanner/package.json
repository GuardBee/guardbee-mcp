{
  "name": "@guardbee/mcp-secret-scanner",
  "version": "1.0.0",
  "mcpName": "io.github.GuardBee/secret-scanner",
  "description": "Secret scanner for code, git history and AI agent transcripts: 76 provider patterns, entropy checks, live key verification and SARIF, as a CLI and an MCP server",
  "type": "module",
  "bin": {
    "guardbee-secret-scanner": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "!dist/**/*.map",
    "!dist/**/__tests__"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@guardbee/guard-core": "workspace:^",
    "@guardbee/mcp-telemetry": "workspace:^",
    "@modelcontextprotocol/sdk": "catalog:",
    "zod": "catalog:"
  },
  "keywords": [
    "mcp",
    "security",
    "secret-scanning",
    "guardbee",
    "devtools",
    "secret-scanner",
    "credential-scanner",
    "gitleaks-alternative",
    "secrets-detection",
    "api-keys",
    "git-history",
    "sarif"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GuardBee/guardbee-mcp.git",
    "directory": "packages/secret-scanner"
  },
  "homepage": "https://guardbee.ai/en/what-is-mcp-secret-scanner/",
  "bugs": {
    "url": "https://github.com/GuardBee/guardbee-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
