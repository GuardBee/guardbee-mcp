{
  "name": "@guardbee/mcp-db-gateway",
  "version": "0.2.0",
  "description": "KVKK/GDPR-compliant MCP server gateway between LLMs and databases",
  "author": "GuardBee <hello@guardbee.ai>",
  "license": "MIT",
  "homepage": "https://github.com/GuardBee/guardbee-mcp-gateway#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/GuardBee/guardbee-mcp-gateway.git"
  },
  "bugs": {
    "url": "https://github.com/GuardBee/guardbee-mcp-gateway/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "llm",
    "gateway",
    "kvkk",
    "gdpr",
    "pii",
    "database",
    "security",
    "prisma",
    "claude"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "guardbee-gateway": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "@prisma/client": ">=4.0.0",
    "pg": ">=8.0.0",
    "mysql2": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/pg": "^8.11.6",
    "pg": "^8.13.1",
    "mysql2": "^3.11.4"
  }
}
