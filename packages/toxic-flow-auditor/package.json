{
  "name": "@guardbee/mcp-toxic-flow-auditor",
  "version": "1.0.2",
  "mcpName": "io.github.GuardBee/toxic-flow-auditor",
  "description": "Lethal trifecta detector for MCP tool catalogs: flags servers that combine untrusted content, sensitive data and exfiltration or destructive tools",
  "type": "module",
  "bin": {
    "guardbee-toxic-flow-auditor": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "!dist/**/*.map",
    "!dist/**/__tests__"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@guardbee/guard-core": "workspace:^",
    "@guardbee/mcp-telemetry": "workspace:^",
    "@modelcontextprotocol/sdk": "catalog:",
    "zod": "catalog:"
  },
  "keywords": [
    "mcp",
    "security",
    "ai-security",
    "mcp-security",
    "toxic-flow",
    "lethal-trifecta",
    "owasp-mcp-top-10",
    "kvkk",
    "guardbee",
    "devtools",
    "agent-security",
    "llm-security",
    "mcp-scanner"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GuardBee/guardbee-mcp.git",
    "directory": "packages/toxic-flow-auditor"
  },
  "homepage": "https://guardbee.ai/en/what-is-mcp-toxic-flow-auditor/",
  "bugs": {
    "url": "https://github.com/GuardBee/guardbee-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
