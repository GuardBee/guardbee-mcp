{
  "name": "@guardbee/mcp-audit-gap-auditor",
  "version": "0.4.1",
  "mcpName": "io.github.GuardBee/audit-gap-auditor",
  "description": "MCP server that audits MCP server source for OWASP MCP08:2025 (Lack of Audit and Telemetry) \u2014 missing tool-call logging, raw args/results in logs, disabled audit sinks, and tool errors swallowed without a record",
  "type": "module",
  "bin": {
    "guardbee-audit-gap-auditor": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "!dist/**/*.map",
    "!dist/**/__tests__"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@guardbee/mcp-telemetry": "workspace:^",
    "@modelcontextprotocol/server": "catalog:",
    "zod": "catalog:"
  },
  "keywords": [
    "mcp",
    "security",
    "ai-security",
    "mcp-security",
    "audit",
    "telemetry",
    "owasp",
    "mcp08",
    "guardbee",
    "devtools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GuardBee/guardbee-mcp.git",
    "directory": "packages/audit-gap-auditor"
  },
  "homepage": "https://guardbee.ai/en/what-is-mcp-audit-gap-auditor/",
  "bugs": {
    "url": "https://github.com/GuardBee/guardbee-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
